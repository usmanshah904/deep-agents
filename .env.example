# Copy this file to .env and fill it in. .env is git-ignored. Never commit real keys.

# ---- AI model ----
# Gemini key from Google AI Studio (https://aistudio.google.com/apikey). Free tier works.
GOOGLE_API_KEY=your-gemini-key
# Main model and backups (LangChain "provider:model" strings). Backups are used when the main
# model is busy (503) or out of quota (429). Each has its own free daily quota.
# GEMINI_MODEL=google_genai:gemini-3.5-flash
# GEMINI_FALLBACKS=google_genai:gemini-3.8-flash,google_genai:gemini-3.5-flash-lite

# ---- Where the cloud data comes from ----
# Billing: "bigquery" = Cloud Billing detailed export table (default; a sample one lives in floci),
#          "mock"     = sample JSON files (no Docker needed for cost questions).
# COST_DATA_SOURCE=bigquery
# BQ_BILLING_TABLE=demo-project.billing_export.gcp_billing_export_resource_v1_012345_6789AB_CDEF01
# BQ_API_URL=http://localhost:4588          # real BigQuery: https://bigquery.googleapis.com
# GCP_ACCESS_TOKEN=                          # real BigQuery only; use a read-only account

# Monitoring, logging and changes: the local floci-gcp emulator.
# OBS_API_URL=http://localhost:4588
# GCP_PROJECT=demo-project

# ---- Dashboard ----
# DASHBOARD_PORT=8060
